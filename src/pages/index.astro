---
import { getEntry, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { REPO_URL, packageFacts } from '../lib/ruleprobe/paths.ts';
import { plainText, readReadme } from '../lib/ruleprobe/readme.ts';

// The pitch is the README's own: its line under the H1 is the headline, and the paragraph after
// it is the lede. Everything below the hero is the README's sections that SECTION_MAP puts here.
const readme = readReadme();
const facts = packageFacts();
const home = await getEntry('readme', 'home');
const lead = await getEntry('readme', 'lead');
if (!home || !lead) throw new Error('The readme collection has no home or lead entry');
const { Content, headings } = await render(home);
const { Content: Lead } = await render(lead);
const description = plainText(readme.lead) || readme.headline;
---

<DocsLayout
  title="Overview"
  description={description}
  crumbs={[{ label: 'overview', mono: true }]}
  sourcePath="README.md"
  sourceLabel="View README on GitHub"
  headings={headings}
  kind="Overview"
>
  <section class="block hero">
    <div class="eyebrow">
      <span class="pill">Open source</span><span class="pill">MIT</span><span class="pill">Python {facts.python}</span>
      {facts.dependencies.length === 0 && <span class="pill">Standard library only</span>}
    </div>
    <h1>{readme.headline}</h1>
    <div class="lede"><Lead /></div>
    <div class="cta">
      <a class="btn primary" href="/install/">Install</a>
      <a class="btn" href="/detectors/">Measure a rule of your own</a>
      <a class="btn" href={REPO_URL}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
        View on GitHub
      </a>
    </div>
  </section>
  <div class="harness-prose">
    <Content />
  </div>
</DocsLayout>
