---
// Pagefind builds the index after `astro build` and serves it from /pagefind/.
// The palette loads that script on first open, so pages ship no search code
// until someone asks for it. In `astro dev` the index is the last build's.
---

<dialog class="palette" id="palette" aria-label="Search">
  <form class="pal-in" role="search" onsubmit="return false">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input id="palInput" type="search" placeholder="Search detectors, matchers, the changelog…" autocomplete="off" aria-label="Search" />
    <kbd class="key">esc</kbd>
  </form>
  <ul class="pal-list" id="palList"></ul>
  <div class="pal-foot"><span>↑↓ move</span><span>↵ open</span><span>Pagefind · indexed at build</span></div>
</dialog>

<script>
  type PagefindResult = { id: string; data: () => Promise<{ url: string; excerpt: string; meta: Record<string, string> }> };
  type Pagefind = { init: () => Promise<void>; debouncedSearch: (q: string) => Promise<{ results: PagefindResult[] } | null> };

  const dlg = document.getElementById('palette') as HTMLDialogElement | null;
  const input = document.getElementById('palInput') as HTMLInputElement | null;
  const list = document.getElementById('palList') as HTMLUListElement | null;
  const btn = document.getElementById('searchBtn');
  let pf: Pagefind | null = null;
  let failed = false;
  let cursor = 0;

  async function engine(): Promise<Pagefind | null> {
    if (pf || failed) return pf;
    try {
      const url = '/pagefind/pagefind.js';
      pf = (await import(/* @vite-ignore */ url)) as Pagefind;
      await pf.init();
    } catch {
      failed = true;
    }
    return pf;
  }

  function open() {
    if (!dlg || !input) return;
    dlg.showModal();
    input.focus();
    input.select();
    void engine().then(() => run());
  }
  function close() {
    dlg?.close();
  }

  function setCursor(i: number) {
    const items = list?.querySelectorAll('a') ?? [];
    if (!items.length) return;
    cursor = (i + items.length) % items.length;
    items.forEach((a, j) => a.classList.toggle('on', j === cursor));
    items[cursor]?.scrollIntoView({ block: 'nearest' });
  }

  async function run() {
    if (!list || !input) return;
    const q = input.value.trim();
    const eng = await engine();
    if (!eng) {
      list.innerHTML = '<li class="pal-empty">Search is built with the site. Run <code>npm run build</code> once, then it works in dev too.</li>';
      return;
    }
    if (!q) {
      list.innerHTML = '<li class="pal-empty">Type to search every rule, stance, skill, agent, command, hook and doc.</li>';
      return;
    }
    const res = await eng.debouncedSearch(q);
    if (!res) return;
    const top = await Promise.all(res.results.slice(0, 10).map((r) => r.data()));
    if (!top.length) {
      list.innerHTML = `<li class="pal-empty">Nothing for “${q.replace(/</g, '&lt;')}”.</li>`;
      return;
    }
    list.innerHTML = top
      .map((d) => {
        const kind = d.meta.kind ? `<span class="pill kind">${d.meta.kind}</span>` : '';
        const title = (d.meta.title ?? d.url).replace(/</g, '&lt;');
        return `<li><a href="${d.url}"><span class="t">${title}</span>${kind}<span class="x">${d.excerpt}</span></a></li>`;
      })
      .join('');
    setCursor(0);
  }

  btn?.addEventListener('click', open);
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dlg?.open ? close() : open();
    }
  });
  dlg?.addEventListener('click', (e) => {
    if (e.target === dlg) close();
  });
  input?.addEventListener('input', () => void run());
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); setCursor(cursor + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setCursor(cursor - 1); }
    else if (e.key === 'Enter') {
      const a = list?.querySelectorAll('a')[cursor];
      if (a) window.location.href = a.href;
    }
  });
</script>
